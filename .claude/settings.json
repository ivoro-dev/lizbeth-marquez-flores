{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npx next typegen)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "mcp__playwright"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./client-assets/**)",
      "Read(./public/images/**)",
      "Read(./package-lock.json)"
    ]
  },
  "enableAllProjectMcpServers": true
}
